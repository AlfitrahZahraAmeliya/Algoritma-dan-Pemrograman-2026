print("Program Menentukan Harga Buku dan Pensil")
print("SPLDV: ax + by = c")
print("      dx + ey = f")

# Input koefisien dan konstanta
a = float(input("Masukkan nilai a: "))
b = float(input("Masukkan nilai b: "))
c = float(input("Masukkan nilai c: "))
d = float(input("Masukkan nilai d: "))
e = float(input("Masukkan nilai e: "))
f = float(input("Masukkan nilai f: "))

# Menghitung nilai x
x = (c * e - b * f) / (a * e - b * d)

# Menghitung nilai y
y = (a * f - c * d) / (a * e - b * d)

# Menampilkan hasil
print("\nHasil:")
print("Harga buku =", x)
print("Harga pensil =", y)
